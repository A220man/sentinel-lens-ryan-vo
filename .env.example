# Sentinel Lens Environment Configuration Example
# Copy to .env for local runtime configuration.
# Never commit credentials or secrets to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL="sqlite:///./sentinel_lens.db"

# Local Demo Mode (binds localhost only; refuses to start in production)
DEMO_MODE=true

# Authentication - Keycloak OIDC with Upstream SAML Broker
# Production requires a valid OIDC issuer and realm discovery
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/sentinel-lens
OIDC_CLIENT_ID=sentinel-lens-app
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=sentinel-lens-api

# LLM Advisory Configuration (Opt-in; deterministic offline engine works without LLM)
# LLM_API_KEY is the single secret credential variable
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Test Runner Configuration
DEFAULT_TARGET=web
DEVICE_POOL_SIZE=4
STEP_TIMEOUT_SECONDS=30
ARTIFACT_STORAGE_PATH=./artifacts
